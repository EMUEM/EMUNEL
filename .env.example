# EMUNEL Configuration
# Copy to .env and update values — or set them in your platform's dashboard.
#
# ZERO-CONFIG: with the three secret variables below UNSET, EMUNEL generates
# strong random ones on first boot and persists them under EMUNEL_DATA_ROOT
# (secrets.json, mode 0600). The initial admin password is printed once in
# the deployment logs. Setting any of them explicitly overrides the
# generated value; weak explicit values are rejected (fail-closed).

# ─── General ──────────────────────────────────────────
EMUNEL_HOST=0.0.0.0
# Leave EMUNEL_PORT unset on Railway/Heroku-style platforms: the injected
# PORT variable is honored automatically.
# EMUNEL_PORT=8080
EMUNEL_DEBUG=false
# 32+ random chars; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# EMUNEL_SECRET_KEY=
EMUNEL_CORS_ORIGINS=["http://localhost:8080"]

# ─── Database ─────────────────────────────────────────
# Default (unset): embedded SQLite stored at EMUNEL_DATA_ROOT/emunel.db —
# one mounted volume persists the whole platform.
# PostgreSQL (or Railway Postgres, which injects DATABASE_URL automatically):
# DATABASE_URL=postgresql+asyncpg://emunel:password@localhost:5432/emunel

# ─── Auth ─────────────────────────────────────────────
# EMUNEL_JWT_SECRET_KEY=
EMUNEL_JWT_ALGORITHM=HS256
EMUNEL_JWT_EXPIRY_MINUTES=1440

# ─── Initial admin (seeded once, then change in the UI) ─
EMUNEL_ADMIN_USERNAME=admin
# EMUNEL_ADMIN_PASSWORD=

# ─── Instances (isolated Core runtimes) ───────────────
EMUNEL_DATA_ROOT=./emunel-data
EMUNEL_PORT_RANGE_START=18100
EMUNEL_PORT_RANGE_END=18999
# Interface Core subprocesses bind: 127.0.0.1 (default, VPS-safe) or 0.0.0.0
# on Railway/Fly-style platforms to make instance ports exposable through
# per-port domains / TCP proxies.
# EMUNEL_CORE_BIND_HOST=0.0.0.0
# Seconds between subscription/link synchronization passes (traffic pull + policy push)
EMUNEL_SYNC_INTERVAL=10
# Startup health timeout for a Core subprocess
EMUNEL_CORE_STARTUP_TIMEOUT=15

# ─── VMess (optional, Core-side) ───────────────────────
# VMess requires an explicitly installed, SHA256-pinned Xray binary.
# The Core never downloads binaries itself.
# EMUNEL_XRAY_BINARY=/usr/local/bin/xray
# EMUNEL_XRAY_SHA256=<sha256 of the binary>

# ─── Diagnostics bounds ────────────────────────────────
EMUNEL_DIAG_TIMEOUT=6
EMUNEL_DIAG_CONCURRENCY=8
EMUNEL_DIAG_RATE_CAPACITY=20
EMUNEL_DIAG_RATE_REFILL=30
