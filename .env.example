# EMUNEL — environment variables
#
# NOTHING here is required. A fresh deployment auto-provisions:
#   * an embedded SQLite database (under /data or .emunel-data)
#   * a session secret key  (EMUNEL_SECRET_KEY, persisted to a 0600 file)
#   * an internal worker token (EMUNEL_WORKER_TOKEN)
#   * the built-in admin account  admin / admin
#
# Set variables only when you want to override the defaults.

# ── database (optional) ────────────────────────────────────────────────────
# PostgreSQL DSN. Auto-detected from any of these platform-injected variables:
#   DATABASE_URL, EMUNEL_DATABASE_URL, POSTGRES_URL, POSTGRESQL_URL,
#   POSTGRES_CONNECTION_STRING, PGHOST/PGUSER/PGPASSWORD/PGDATABASE/PGPORT
# DATABASE_URL=postgresql://user:pass@host:5432/emunel

# ── secrets (optional — auto-generated and persisted when unset) ────────────
# EMUNEL_SECRET_KEY=change-me-48-plus-random-chars
# EMUNEL_WORKER_TOKEN=change-me

# ── public URL (optional — used for OAuth callback + link contents) ────────
# EMUNEL_PUBLIC_URL=https://your-domain.up.railway.app

# ── GitHub OAuth login (optional; password login works without it) ─────────
# EMUNEL_GITHUB_CLIENT_ID=
# EMUNEL_GITHUB_CLIENT_SECRET=
# EMUNEL_ADMIN_GITHUB_LOGIN=        # first GitHub user to become admin

# ── console runtime (optional) ─────────────────────────────────────────────
# PORT=8080                          # injected by Railway/Render automatically
# EMUNEL_CONSOLE_PORT=8080
# EMUNEL_LOG_LEVEL=info
# EMUNEL_COOKIE_SECURE=1             # when serving HTTPS directly (no edge)

# ── worker / node (optional — embedded worker is automatic) ─────────────────
# EMUNEL_WORKER_DRIVER=process       # docker | process (auto: docker if available)
# EMUNEL_WORKER_DATA=/data/instances
# EMUNEL_NODE_ID=local
# EMUNEL_NODE_REGION=local
# EMUNEL_NODE_CAPACITY=20
# EMUNEL_WORKER_HEARTBEAT_SECONDS=15

# ── panel links (optional) ──────────────────────────────────────────────────
# EMUNEL_TELEGRAM_CHANNEL=https://t.me/yourchannel   # shown in sidebar/headers

# ══════════════════════════════════════════════════════════════════════════
# EMUNEL ENGINES — traffic plugin layer (see engines/README.md)
# ══════════════════════════════════════════════════════════════════════════
# State + logs live under EMUNEL_ENGINE_DATA (default /data/engines, i.e.
# the Railway volume). Attach a volume at /data so learned ISP profiles and
# engine state survive redeploys (this is storage persistence — unrelated to
# user traffic quotas). A probe file warns in the panel when data resets.

# ── engine system ───────────────────────────────────────────────────────────
# EMUNEL_ENGINES_ENABLED=1                      # master switch (0 = bit-for-bit old behaviour)
# EMUNEL_PIPELINE_ORDER=Coalesce,Morph,Compress,PreConnect,FEC,Congestion,SessionResumption,FakeHandshake,SplitTunnel,SNIRotation,DomainFronting,PortHopping
# PIPELINE_ORDER=                               # plain alias, EMUNEL_PIPELINE_ORDER wins
# EMUNEL_ENGINE_DATA=/data/engines              # state + logs directory
# EMUNEL_ENGINE_BYPASS_ERRORS=3                  # consecutive failures -> cooldown bypass
# EMUNEL_ENGINE_BYPASS_COOLDOWN_SEC=60          # how long a failing engine stays off
# EMUNEL_ENGINE_STATUS_CACHE_SEC=15              # per-instance core status cache
# EMUNEL_ENGINE_MAX_OPS_PER_SEC=2000            # whole-pipeline ops ceiling (over -> passthrough)
# EMUNEL_ENGINE_MAX_BUFFER_BYTES=262144         # per-batch transform buffer ceiling
# EMUNEL_ENGINE_HTTP_MAX_BUFFER_BYTES=8388608   # subscription-rewrite body cap

# Per-engine enable flags: unset = default (toggleable in the panel),
# explicitly 0 = hard kill-switch the panel cannot override.
# EMUNEL_ENGINE_COALESCE_ENABLED=1
# EMUNEL_ENGINE_MORPH_ENABLED=0
# EMUNEL_ENGINE_COMPRESS_ENABLED=0
# EMUNEL_ENGINE_PRECONNECT_ENABLED=1
# EMUNEL_ENGINE_FEC_ENABLED=0
# EMUNEL_ENGINE_CONGESTION_ENABLED=1
# EMUNEL_ENGINE_SESSION_RESUMPTION_ENABLED=1
# EMUNEL_ENGINE_FAKE_HANDSHAKE_ENABLED=1
# EMUNEL_ENGINE_SPLIT_TUNNEL_ENABLED=1
# EMUNEL_ENGINE_SNI_ROTATION_ENABLED=0
# EMUNEL_ENGINE_FRONTING_ENABLED=0
# EMUNEL_ENGINE_PORT_HOPPING_ENABLED=0

# ── Coalescing (downlink frame merging) ──────────────────────────────────────
# MAX_COALESCE_SIZE=16384                        # bytes — merge frames up to this size
# COALESCE_TIMEOUT_MS=8                          # max wait before flushing a partial batch
# EMUNEL_ENGINE_COALESCE_MAX_BUFFER=262144       # per-connection backpressure cap

# ── Morphing (ISP profiles + LinUCB bandit) ──────────────────────────────────
# EMUNEL_MORPH_DEFAULT_CHUNK=16384               # default profile chunk size (bytes)
# EMUNEL_MORPH_DEFAULT_INTER_DELAY_MS=0           # default inter-chunk pacing
# EMUNEL_MORPH_PADDING_PERCENT=0                 # reported only (streams cannot be padded)
# EMUNEL_MORPH_BANDIT_ALPHA=0.35                 # LinUCB exploration
# EMUNEL_MORPH_ISP_PREFIXES=2.144.0.0/13=mci,2.148.0.0/14=irancell,...   # IP->ISP map (bundled defaults)
# EMUNEL_MORPH_PROFILES={"mci":[{"name":"video","chunk":32768,"sizes":[1400,1300]}]}   # per-ISP profiles JSON
# EMUNEL_MORPH_SELFPLAY=0                        # background self-probing
# EMUNEL_MORPH_SELFPLAY_URL=https://your-app.up.railway.app/i/<token>/...
# EMUNEL_MORPH_SELFPLAY_INTERVAL_SEC=300
# EMUNEL_MORPH_SUCCESS_BYTES=4096                # bytes relayed == session "worked"

# ── Compression ───────────────────────────────────────────────────────────────
# COMPRESSION_LEVEL=6                            # 0-9 (zlib), brotli quality when installed
# MIN_SAVING_PERCENT=5                           # below this the batch passes through
# EMUNEL_COMPRESS_ALGOS=zlib                     # zlib (+brotli when the wheel exists)
# EMUNEL_ENGINE_COMPRESS_MAX_SAMPLE=65536        # content sniff window

# ── Pre-connect (core host) ───────────────────────────────────────────────────
# PRECONNECT_POOL_SIZE=2                         # warm sockets per (host,port)
# PRECONNECT_TTL_SEC=30                          # warm socket lifetime
# EMUNEL_PRECONNECT_MAX_HOSTS=32                 # LRU bound on distinct hosts
# EMUNEL_PRECONNECT_CONNECT_TIMEOUT=3.0

# ── FEC (dormant on TCP transports) ────────────────────────────────────────────
# FEC_RATIO=0.25                                 # parity blocks per data group
# FEC_BLOCK_SIZE=1408                            # codec block size (bytes)

# ── Congestion-aware (core host) ───────────────────────────────────────────────
# CC_DEFAULT=bbr                                 # advisory label (kernel CC is not switchable unprivileged)
# CC_SWITCH_THRESHOLD=2.0                        # loss % above which tuning/advisory degrades
# EMUNEL_CC_RTT_WINDOW_SEC=30                     # measurement window
# EMUNEL_CC_SOCK_BUF=262144                       # base socket buffer (adapted by loss/RTT)
# EMUNEL_CC_QUICKACK=1

# ── 0-RTT session resumption ────────────────────────────────────────────────────
# SESSION_CACHE_SIZE=256                         # pool entries
# SESSION_TTL_HOURS=24                           # pool entry lifetime

# ── Fake handshake (probe defense) ──────────────────────────────────────────────
# EMUNEL_FAKE_SERVER_TYPE=nginx                  # nginx | apache — page style served to non-browsers

# ── Split tunneling (Iran direct rules in singbox/clash feeds) ──────────────────
# EMUNEL_SPLIT_DOMAINS=.ir,aparat.com,digikala.com,...   # (bundled default list)
# EMUNEL_SPLIT_IP_CIDRS=                         # optional extra IP rules

# ── SNI rotation (needs domains attached to the deployment) ──────────────────────
# EMUNEL_SNI_DOMAINS=a.example.com,b.example.com  # >= 2 domains attached in Railway settings

# ── Domain fronting (self-hosted edge only) ──────────────────────────────────────
# EMUNEL_FRONTING_SNI_DOMAIN=cdn.example.ir       # domestic front (TLS SNI)
# EMUNEL_FRONTING_REAL_HOST=app.example.com       # real backend (Host header)

# ── Port hopping (multi-port edges only; Railway exposes one port) ──────────────
# EMUNEL_PORT_HOPPING_PORTS=443,8443,2053,2083,2087,2096
