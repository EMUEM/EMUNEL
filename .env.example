# EMUNEL Configuration — everything below is OPTIONAL.
#
# ZERO-CONFIG (reference parity): deploy with NO variables set and everything
# is auto-provisioned on first boot:
#   * EMUNEL_SECRET_KEY / EMUNEL_JWT_SECRET_KEY — strong random values,
#     persisted to EMUNEL_DATA_ROOT/secrets.json (0600)
#   * database — embedded SQLite at EMUNEL_DATA_ROOT/emunel.db
#   * admin account — admin / admin (change the password after first login)
#   * PORT — platform-injected (Railway/Heroku) is honored automatically
# Set any variable explicitly to override its auto-provisioned value.

# ─── General ──────────────────────────────────────────
EMUNEL_HOST=0.0.0.0
# EMUNEL_PORT=8080   # unset → injected PORT (Railway) or 8000
EMUNEL_DEBUG=false
# EMUNEL_SECRET_KEY=            # unset → auto-generated + persisted
# EMUNEL_CORS_ORIGINS=["https://your-domain"]

# ─── Database ─────────────────────────────────────────
# Default (unset): embedded SQLite inside EMUNEL_DATA_ROOT — one mounted
# volume persists the whole platform. PostgreSQL (or Railway Postgres,
# which injects DATABASE_URL automatically):
# DATABASE_URL=postgresql+asyncpg://emunel:password@localhost:5432/emunel
# Startup retries while Postgres is provisioning; if it stays down the app
# serves degraded and keeps retrying in the background (never crash-loops).

# ─── Auth ─────────────────────────────────────────────
# EMUNEL_JWT_SECRET_KEY=         # unset → auto-generated + persisted
# EMUNEL_JWT_ALGORITHM=HS256
# EMUNEL_JWT_EXPIRY_MINUTES=1440

# ─── Initial admin (seeded once, then change in the UI) ─
# Defaults to admin / admin — exactly like the reference project.
EMUNEL_ADMIN_USERNAME=admin
# EMUNEL_ADMIN_PASSWORD=admin

# ─── Instances (isolated Core runtimes) ───────────────
EMUNEL_DATA_ROOT=./emunel-data
EMUNEL_PORT_RANGE_START=18100
EMUNEL_PORT_RANGE_END=18999
# EMUNEL_CORE_BIND_HOST=0.0.0.0  # expose instance ports via edge proxies
EMUNEL_SYNC_INTERVAL=10
EMUNEL_CORE_STARTUP_TIMEOUT=15
# EMUNEL_DB_INIT_ATTEMPTS=30     # DB connect retries at boot (3s apart)

# ─── VMess (optional, Core-side) ───────────────────────
# VMess requires an explicitly installed, SHA256-pinned Xray binary.
# The Core never downloads binaries itself.
# EMUNEL_XRAY_BINARY=/usr/local/bin/xray
# EMUNEL_XRAY_SHA256=<sha256 of the binary>

# ─── Diagnostics bounds ────────────────────────────────
EMUNEL_DIAG_TIMEOUT=6
EMUNEL_DIAG_CONCURRENCY=8
EMUNEL_DIAG_RATE_CAPACITY=20
EMUNEL_DIAG_RATE_REFILL=30
