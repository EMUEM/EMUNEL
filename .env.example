# EMUNEL Configuration
# Copy to .env and update values.
# NOTE: the API refuses to start in production mode (EMUNEL_DEBUG=false)
# with placeholder secrets or an admin password shorter than 12 chars.

# ─── General ──────────────────────────────────────────
EMUNEL_HOST=0.0.0.0
EMUNEL_PORT=8080
EMUNEL_DEBUG=false
# 32+ random chars; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
EMUNEL_SECRET_KEY=change-me-to-a-random-secret-key
EMUNEL_CORS_ORIGINS=["http://localhost:8080"]

# ─── Database ─────────────────────────────────────────
# SQLite (zero-config, default) — stored under EMUNEL_DATA_ROOT or CWD:
DATABASE_URL=sqlite+aiosqlite:///./emunel.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://emunel:password@localhost:5432/emunel

# ─── Auth ─────────────────────────────────────────────
EMUNEL_JWT_SECRET_KEY=change-me-jwt-secret
EMUNEL_JWT_ALGORITHM=HS256
EMUNEL_JWT_EXPIRY_MINUTES=1440

# ─── Initial admin (seeded once, then change in the UI) ─
EMUNEL_ADMIN_USERNAME=admin
EMUNEL_ADMIN_PASSWORD=change-me-at-least-12-chars

# ─── Instances (isolated Core runtimes) ───────────────
EMUNEL_DATA_ROOT=./emunel-data
EMUNEL_PORT_RANGE_START=18100
EMUNEL_PORT_RANGE_END=18999
# Seconds between subscription/link synchronization passes (traffic pull + policy push)
EMUNEL_SYNC_INTERVAL=10
# Startup health timeout for a Core subprocess
EMUNEL_CORE_STARTUP_TIMEOUT=15

# ─── VMess (optional, Core-side) ───────────────────────
# VMess requires an explicitly installed, SHA256-pinned Xray binary.
# The Core never downloads binaries itself.
# EMUNEL_XRAY_BINARY=/usr/local/bin/xray
# EMUNEL_XRAY_SHA256=<sha256 of the binary>

# ─── Diagnostics bounds ────────────────────────────────
EMUNEL_DIAG_TIMEOUT=6
EMUNEL_DIAG_CONCURRENCY=8
EMUNEL_DIAG_RATE_CAPACITY=20
EMUNEL_DIAG_RATE_REFILL=30
