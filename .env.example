# EMUNEL Configuration
# Copy this file to .env and update values

# ─── General ──────────────────────────────────────────
EMUNEL_HOST=0.0.0.0
EMUNEL_PORT=8000
EMUNEL_DEBUG=false
EMUNEL_SECRET_KEY=change-me-to-a-random-secret-key

# ─── Database ─────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql+asyncpg://emunel:password@localhost:5432/emunel
# SQLite fallback (for development)
# DATABASE_URL=sqlite+aiosqlite:///./emunel.db

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ─── Admin ────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ─── Core Proxy ───────────────────────────────────────
CORE_LISTEN_HOST=0.0.0.0
CORE_LISTEN_PORT=443
CORE_TLS_CERT=/etc/emunel/cert.pem
CORE_TLS_KEY=/etc/emunel/key.pem

# ─── Worker ───────────────────────────────────────────
WORKER_API_URL=http://localhost:8000
WORKER_TOKEN=change-me-worker-token
WORKER_HEARTBEAT_INTERVAL=30

# ─── Dashboard ────────────────────────────────────────
DASHBOARD_PORT=8080

# ─── Prometheus ───────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
