# EMUNEL — environment variables
#
# NOTHING here is required. A fresh deployment auto-provisions:
#   * an embedded SQLite database (under /data or .emunel-data)
#   * a session secret key  (EMUNEL_SECRET_KEY, persisted to a 0600 file)
#   * an internal worker token (EMUNEL_WORKER_TOKEN)
#   * the built-in admin account  admin / admin
#
# Set variables only when you want to override the defaults.

# ── database (optional) ────────────────────────────────────────────────────
# PostgreSQL DSN. Auto-detected from any of these platform-injected variables:
#   DATABASE_URL, EMUNEL_DATABASE_URL, POSTGRES_URL, POSTGRESQL_URL,
#   POSTGRES_CONNECTION_STRING, PGHOST/PGUSER/PGPASSWORD/PGDATABASE/PGPORT
# DATABASE_URL=postgresql://user:pass@host:5432/emunel

# ── secrets (optional — auto-generated and persisted when unset) ────────────
# EMUNEL_SECRET_KEY=change-me-48-plus-random-chars
# EMUNEL_WORKER_TOKEN=change-me

# ── public URL (optional — used for OAuth callback + link contents) ────────
# EMUNEL_PUBLIC_URL=https://your-domain.up.railway.app

# ── GitHub OAuth login (optional; password login works without it) ─────────
# EMUNEL_GITHUB_CLIENT_ID=
# EMUNEL_GITHUB_CLIENT_SECRET=
# EMUNEL_ADMIN_GITHUB_LOGIN=        # first GitHub user to become admin

# ── console runtime (optional) ─────────────────────────────────────────────
# PORT=8080                          # injected by Railway/Render automatically
# EMUNEL_CONSOLE_PORT=8080
# EMUNEL_LOG_LEVEL=info
# EMUNEL_COOKIE_SECURE=1             # when serving HTTPS directly (no edge)

# ── worker / node (optional — embedded worker is automatic) ─────────────────
# EMUNEL_WORKER_DRIVER=process       # docker | process (auto: docker if available)
# EMUNEL_WORKER_DATA=/data/instances
# EMUNEL_NODE_ID=local
# EMUNEL_NODE_REGION=local
# EMUNEL_NODE_CAPACITY=20
# EMUNEL_WORKER_HEARTBEAT_SECONDS=15

# ── panel links (optional) ──────────────────────────────────────────────────
# EMUNEL_TELEGRAM_CHANNEL=https://t.me/yourchannel   # shown in sidebar/headers

# ══════════════════════════════════════════════════════════════════════════
# EMUNEL ENGINES — traffic plugin layer (see engines/README.md)
# ══════════════════════════════════════════════════════════════════════════
# State + logs live under EMUNEL_ENGINE_DATA (default /data/engines, i.e.
# the Railway volume). Attach a volume at /data so learned ISP profiles and
# engine state survive redeploys (this is storage persistence — unrelated to
# user traffic quotas). A probe file warns in the panel when data resets.

# ── engine system ───────────────────────────────────────────────────────────
# EMUNEL_ENGINES_ENABLED=1                      # master switch (0 = bit-for-bit old behaviour)
# EMUNEL_PIPELINE_ORDER=Coalesce,Morph,Compress,PreConnect,FEC,Congestion,SessionResumption,FakeHandshake,SplitTunnel,SNIRotation,DomainFronting,PortHopping
# PIPELINE_ORDER=                               # plain alias, EMUNEL_PIPELINE_ORDER wins
# EMUNEL_ENGINE_DATA=/data/engines              # state + logs directory
# EMUNEL_ENGINE_BYPASS_ERRORS=3                  # consecutive failures -> cooldown bypass
# EMUNEL_ENGINE_BYPASS_COOLDOWN_SEC=60          # how long a failing engine stays off
# EMUNEL_ENGINE_STATUS_CACHE_SEC=15              # per-instance core status cache
# EMUNEL_ENGINE_MAX_OPS_PER_SEC=2000            # whole-pipeline ops ceiling (over -> passthrough)
# EMUNEL_ENGINE_MAX_BUFFER_BYTES=262144         # per-batch transform buffer ceiling
# EMUNEL_ENGINE_HTTP_MAX_BUFFER_BYTES=8388608   # subscription-rewrite body cap

# Per-engine enable flags: unset = default (toggleable in the panel),
# explicitly 0 = hard kill-switch the panel cannot override.
# EMUNEL_ENGINE_COALESCE_ENABLED=1
# EMUNEL_ENGINE_MORPH_ENABLED=0
# EMUNEL_ENGINE_COMPRESS_ENABLED=0
# EMUNEL_ENGINE_PRECONNECT_ENABLED=1
# EMUNEL_ENGINE_FEC_ENABLED=0
# EMUNEL_ENGINE_CONGESTION_ENABLED=1
# EMUNEL_ENGINE_SESSION_RESUMPTION_ENABLED=1
# EMUNEL_ENGINE_FAKE_HANDSHAKE_ENABLED=1
# EMUNEL_ENGINE_SPLIT_TUNNEL_ENABLED=1
# EMUNEL_ENGINE_SNI_ROTATION_ENABLED=0
# EMUNEL_ENGINE_FRONTING_ENABLED=0
# EMUNEL_ENGINE_PORT_HOPPING_ENABLED=0

# ── Coalescing (downlink frame merging) ──────────────────────────────────────
# MAX_COALESCE_SIZE=16384                        # bytes — merge frames up to this size
# COALESCE_TIMEOUT_MS=8                          # max wait before flushing a partial batch
# EMUNEL_ENGINE_COALESCE_MAX_BUFFER=262144       # per-connection backpressure cap

# ── Morphing (ISP profiles + LinUCB bandit) ──────────────────────────────────
# EMUNEL_MORPH_DEFAULT_CHUNK=16384               # default profile chunk size (bytes)
# EMUNEL_MORPH_DEFAULT_INTER_DELAY_MS=0           # default inter-chunk pacing
# EMUNEL_MORPH_PADDING_PERCENT=0                 # reported only (streams cannot be padded)
# EMUNEL_MORPH_BANDIT_ALPHA=0.35                 # LinUCB exploration
# EMUNEL_MORPH_ISP_PREFIXES=2.144.0.0/13=mci,2.148.0.0/14=irancell,...   # IP->ISP map (bundled defaults)
# EMUNEL_MORPH_PROFILES={"mci":[{"name":"video","chunk":32768,"sizes":[1400,1300]}]}   # per-ISP profiles JSON
# EMUNEL_MORPH_SELFPLAY=0                        # background self-probing
# EMUNEL_MORPH_SELFPLAY_URL=https://your-app.up.railway.app/i/<token>/...
# EMUNEL_MORPH_SELFPLAY_INTERVAL_SEC=300
# EMUNEL_MORPH_SUCCESS_BYTES=4096                # bytes relayed == session "worked"

# ── Compression ───────────────────────────────────────────────────────────────
# COMPRESSION_LEVEL=6                            # 0-9 (zlib), brotli quality when installed
# MIN_SAVING_PERCENT=5                           # below this the batch passes through
# EMUNEL_COMPRESS_ALGOS=zlib                     # zlib (+brotli when the wheel exists)
# EMUNEL_ENGINE_COMPRESS_MAX_SAMPLE=65536        # content sniff window

# ── Pre-connect (core host) ───────────────────────────────────────────────────
# PRECONNECT_POOL_SIZE=2                         # warm sockets per (host,port)
# PRECONNECT_TTL_SEC=30                          # warm socket lifetime
# EMUNEL_PRECONNECT_MAX_HOSTS=32                 # LRU bound on distinct hosts
# EMUNEL_PRECONNECT_CONNECT_TIMEOUT=3.0

# ── FEC (dormant on TCP transports) ────────────────────────────────────────────
# FEC_RATIO=0.25                                 # parity blocks per data group
# FEC_BLOCK_SIZE=1408                            # codec block size (bytes)

# ── Congestion-aware (core host) ───────────────────────────────────────────────
# CC_DEFAULT=bbr                                 # advisory label (kernel CC is not switchable unprivileged)
# CC_SWITCH_THRESHOLD=2.0                        # loss % above which tuning/advisory degrades
# EMUNEL_CC_RTT_WINDOW_SEC=30                     # measurement window
# EMUNEL_CC_SOCK_BUF=262144                       # base socket buffer (adapted by loss/RTT)
# EMUNEL_CC_QUICKACK=1

# ── 0-RTT session resumption ────────────────────────────────────────────────────
# SESSION_CACHE_SIZE=256                         # pool entries
# SESSION_TTL_HOURS=24                           # pool entry lifetime

# ── Fake handshake (probe defense) ──────────────────────────────────────────────
# EMUNEL_FAKE_SERVER_TYPE=nginx                  # nginx | apache — page style served to non-browsers

# ── Split tunneling (Iran direct rules in singbox/clash feeds) ──────────────────
# EMUNEL_SPLIT_DOMAINS=.ir,aparat.com,digikala.com,...   # (bundled default list)
# EMUNEL_SPLIT_IP_CIDRS=                         # optional extra IP rules

# ── SNI rotation (needs domains attached to the deployment) ──────────────────────
# EMUNEL_SNI_DOMAINS=a.example.com,b.example.com  # >= 2 domains attached in Railway settings

# ── Domain fronting (self-hosted edge only) ──────────────────────────────────────
# EMUNEL_FRONTING_SNI_DOMAIN=cdn.example.ir       # domestic front (TLS SNI)
# EMUNEL_FRONTING_REAL_HOST=app.example.com       # real backend (Host header)

# ── Port hopping (multi-port edges only; Railway exposes one port) ──────────────
# EMUNEL_PORT_HOPPING_PORTS=443,8443,2053,2083,2087,2096

# ── Volume enforcement (second line — the first line is the Core's relay-time cap) ──
# EMUNEL_VOLUME_CHECK_SECONDS=45                 # console polling interval
# EMUNEL_VOLUME_STALE_ALERT_MISSES=2             # alert after N unreachable stats checks
# EMUNEL_VOLUME_STALE_STOP_MINUTES=0              # 0 = alert only; N = stop instance after N blind minutes

# ── Gateway stability (request storms / reconnect loops) ───────────────────────
# EMUNEL_ENDPOINT_CACHE_SECONDS=15               # TTL for endpoint token resolution (proxy path)
# EMUNEL_ENDPOINT_CACHE_NEG_SECONDS=4             # TTL for dead-endpoint results (shorter)
# Notes: proxy traffic through /i/* is NEVER rate-limited (xHTTP packet-up
# clients + carrier NAT). Limits apply only to /auth/* and /api/*:
#   auth 30/min per IP (mutations), API reads 1200/min, API writes 240/min.

# ── Engine toggles ──────────────────────────────────────────────────────────────
# Hot Enable/Disable from the panel now PERSISTS across restarts in the engine
# state store (/data/engines). An explicit =0 below is still a hard kill-switch
# that the panel cannot override. Morph now ships ON by default (its baseline
# profile is a byte-exact passthrough).

# ── SNI Spoofing (Bypass tab — profile for the client-side helper) ──────────────
# SNI_METHOD=combined                            # fragment | fake_sni | combined
# SNI_FRAGMENT_STRATEGY=sni_split                # sni_split | half | multi | tls_record_frag
# SNI_FRAGMENT_DELAY=0.1                         # seconds between fragments (0.1-0.5 recommended)
# SNI_TTL_TRICK=1                                # send the fake packet with a low TTL
# SNI_TTL_VALUE=1                                # TTL 1-8 (how many hops the fake packet survives)
# SNI_FAKE_SNI=www.microsoft.com                 # SNI carried by the fake packet
# SNI_POOL=cdnjs.cloudflare.com,www.hcaptcha.com,auth.vercel.com,www.google.com
# SNI_LISTEN_PORT=40443                          # helper's local listen port (client device)
# EMUNEL_SNI_MAX_CONNS=256                       # helper concurrency bound

# ── REALITY (Bypass tab — keypairs, configs, optional pinned runtime) ──────────
# REALITY_TARGET=blubank.com:443                 # TLS camouflage target (RAW transport)
# XHTTP_REALITY_TARGET=divar.ir:443              # target for the XHTTP variant
# REALITY_SERVER_NAMES=                          # blank = derived from the target
# REALITY_FINGERPRINT=chrome                      # chrome | firefox | safari | ios | android | edge | randomized
# REALITY_SHORT_IDS=,0123456789abcdef             # blank first entry = anonymous short id
# REALITY_SPIDER_X=/                             # spider path
# REALITY_PRIVATE_KEY=                           # base64 X25519 (generated in the panel if unset)
# REALITY_PUBLIC_KEY=                            # derived from the private key when set
# REALITY_UUID=                                  # client uuid (generated when unset)
# REALITY_FLOW=xtls-rprx-vision                  # RAW-transport flow control
# EMUNEL_REALITY_LISTEN_HOST=0.0.0.0             # optional runtime listener bind
# EMUNEL_REALITY_LISTEN_PORT=8443                 # optional runtime port -> Railway TCP Proxy
# EMUNEL_REALITY_PUBLIC_PORT=0                   # 0 = same as listen; set to the TCP-proxy public port
# EMUNEL_XRAY_BINARY=                            # absolute path to an installed Xray (runtime opt-in)
# EMUNEL_XRAY_SHA256=                            # 64-hex digest pin — a mismatched binary is refused

# ═══════════════════════════════════════════════════════════════════════════
# EVOLUTION ENGINES — Chaos Protocol / DpiMesh / GeneticEngine / Synergy
# Every flag defaults to FALSE: a deployment that sets none of these
# behaves byte-identically to a build without the engines (snapshot-tested).
# Turn them on one at a time; each engine degrades independently and the
# proxy Core is never involved.
# ═══════════════════════════════════════════════════════════════════════════
# CHAOS_PROTOCOL_ENABLED=false                   # shape-shifting framing engine
# CHAOS_SECRET=change_me_please                  # shared schedule secret (SET THIS)
# CHAOS_TICK_MS=30000                            # base window (30s -> 30-90s changes)
# CHAOS_MAX_SESSIONS=1024                        # LRU session cap (RAM < 5MB)
# DPI_MESH_ENABLED=false                         # crowd-sourced DPI map engine
# MESH_SALT=change_me_please                     # privacy salt (SET THIS)
# MESH_AGGREGATE_INTERVAL_SEC=300                # policy sweep cadence
# MESH_RETENTION_HOURS=24                        # signature retention
# MESH_MAX_DB_MB=10                              # volume guard -> degraded mode
# GENETIC_ENGINE_ENABLED=false                    # genome population engine
# GENETIC_POPULATION_SIZE=20                     # genomes per generation
# GENETIC_MUTATION_RATE=0.05                      # per-parameter mutation rate
# GENETIC_EVOLVE_INTERVAL_SEC=21600              # evolve every 6h
# GENETIC_MAX_DB_MB=1                            # volume guard -> frozen population
# SYNERGY_ENABLED=false                           # coordination loop engine
# SYNERGY_LOOP_SEC=300                            # DpiMesh->Genetic->Chaos cycle

# ═══════════════════════════════════════════════════════════════════════════
# SNI ENHANCED — stateful DPI evasion (control plane + client helper)
# Default OFF: a deployment that sets none of these behaves byte-identically
# to before (snapshot-tested). The panel builds/proves the plans; execution
# runs on user devices through the downloadable helper.
# ═══════════════════════════════════════════════════════════════════════════
# SNI_ENHANCED_ENABLED=false                      # master flag (tab + engine)
# SNI_ENHANCED_METHOD=combined                    # technique: fragment|fake_sni|combined|hostfakesplit|multisplit|multidisorder|fakedsplit|fakeddisorder|tlsrec|oob|disoob|wrong_seq|md5sig|syndata|synack
# SNI_ENHANCED_FOOLING=md5sig                     # md5sig|badseq|badsum|ts|autottl
# SNI_ENHANCED_MULTISPLIT_SEQOVL=568              # overlapping-seq offset (Flowseal default)
# SNI_ENHANCED_FRAGMENT_DELAY=0.15                # seconds between fragments (0.05-2.0)
# SNI_ENHANCED_TTL_VALUE=4                        # decoy TTL 1-8
# SNI_ENHANCED_SCAN_INTERVAL_HOURS=6              # CDN/decoy-target auto-scan cadence
# SNI_ENHANCED_FINGERPRINT=chrome                 # chrome|firefox|safari|randomized
# SNI_ENHANCED_POOL=                              # blank = engines/sni_enhanced/ir_allowed_snis.json
# EMUNEL_SNI_ENHANCED_SCAN_MIN_INTERVAL=30        # min seconds between scans
# EMUNEL_SNI_ENHANCED_MAX_STATE_KB=512            # engine state volume guard

# ── Compression (the Compress engine's real channel) ────────────────────────
# EMUNEL_HTTP_COMPRESSION=false                   # gzip/brotli for panel/API/subscription
#                                                # responses — or hot-enable the
#                                                # Compress engine in Engine Settings

# ── REALITY runtime extras ───────────────────────────────────────────────────
# REALITY_PUBLIC_HOST=                            # TCP-proxy host[:port] for generated configs
#                                                # (XRAY_VERSION + XRAY_SHA256 service vars
#                                                #  bake a verified Xray at build time —
#                                                #  see docs/RAILWAY.md)

# ═══════════════════════════════════════════════════════════════════════════
# STABILIZATION — data persistence, OOM guard, merged engine modules
# Everything here is OFF by default: a deployment that sets none of these
# behaves byte-identically to before (snapshot-tested).
# ═══════════════════════════════════════════════════════════════════════════

# ── Railway data persistence (docs/RAILWAY.md "Stabilization") ──────────────
# 1. Settings -> Volumes: mount a volume at /data (instances, engine state
#    and the SQLite console DB live there; WITHOUT it every redeploy wipes them)
# 2. Variables: RAILWAY_RUN_UID=0  (Railway volumes are root-owned — this
#    runs the container as root so /data is writable)
# Backups run automatically once a volume is present:
# EMUNEL_BACKUP_INTERVAL_H=6                      # backup cron cadence (hours)
# EMUNEL_BACKUP_KEEP=7                            # rotating copies kept
# EMUNEL_BACKUP_MAX_MB=64                         # backup area size cap

# ── OOM guard (keeps RSS under the Railway plan; never kills the app) ───────
# EMUNEL_SOFT_MEM_MB=380                          # soft: caches cleared + gc
# EMUNEL_HARD_MEM_MB=460                          # hard: pools drained too
# EMUNEL_MEM_CHECK_SEC=30                         # RSS check cadence
# EMUNEL_MEM_EMERGENCY_STOPS=2                    # consecutive hard hits -> engines shed, panel survives
# (Dockerfile sets MALLOC_ARENA_MAX=2 — the glibc RSS reducer)

# ── Reconnect-storm / WebSocket hardening ─────────────────────────────────────
# EMUNEL_WS_MAX_CONNECTIONS=60                     # live WS relays per hop; over-cap close 1013
# EMUNEL_WS_MAX_FRAME_BYTES=4194304               # inbound frame cap per connection
# EMUNEL_WS_WRITE_TIMEOUT=10                      # a stalled peer is cut, not pinned
# EMUNEL_ENGINE_BACKPRESSURE_TIMEOUT=15           # full downlink buffer + stalled flush -> drop
# EMUNEL_LIMIT_CONCURRENCY=512                    # uvicorn in-flight cap (0=off)
# EMUNEL_MONITOR_SEC=30                          # worker memory/conn monitor line cadence

# ── Merged engine modules (one module per functional group) ──────────────────
# TRAFFIC_SHAPING_MERGED=false                    # Morph + SNIEnhanced + Chaos
# TRANSPORT_MERGED=false                           # PreConnect + Congestion + FEC + SessionResumption
#                                                # (core-side children imply the engines host)
# LEARNING_MERGED=false                           # Mesh + Genetic + Synergy
# PAYLOAD_MERGED=false                            # Coalesce + Compress
# LEGACY_ENGINES_ENABLED=true                     # standalone fallback engines
# Internal order of each module (env-tunable, comma list, first-run wins):
# EMUNEL_TS_PIPELINE=Morph,SNIEnhanced,Chaos
# EMUNEL_TRANSPORT_PIPELINE=PreConnect,Congestion,FEC,SessionResumption
# EMUNEL_LEARNING_PIPELINE=Mesh,Genetic,Synergy
# EMUNEL_PAYLOAD_PIPELINE=Coalesce,Compress

# ── Performance knobs ────────────────────────────────────────────────────────
# EMUNEL_TS_CACHE=1                               # configgen decision cache
# EMUNEL_TS_CACHE_TTL=300                         # decision cache TTL (s)
# EMUNEL_TS_CACHE_MAX=100                          # decision cache entries
# EMUNEL_ENGINES_STATUS_TTL=5                     # /api/engines TTL cache (s; 0=off)
# EMUNEL_MESH_POLICY_TTL=60                       # /api/mesh/policy TTL cache (s)
# EMUNEL_HTTP_COMPRESS_MIN_BYTES=256              # set 1024 with PAYLOAD_MERGED
# EMUNEL_ENGINE_DEBUG=false                       # temporary init/process logs
